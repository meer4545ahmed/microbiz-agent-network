# Copy this file to .env. Never commit .env or share its contents.
# Use long, unique development-only seed phrases; do not reuse real passwords.
COORDINATOR_SEED=replace-with-a-unique-long-random-development-seed
ANALYST_SEED=replace-with-a-different-unique-long-random-development-seed

# Start the analyst first. Copy its printed agent address here before starting coordinator.
ANALYST_ADDRESS=replace-with-analyst-agent-address
